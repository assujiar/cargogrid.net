# =============================================================================
# CargoGrid OS — environment variables
# =============================================================================
# Every variable below is read somewhere in this repo; the file reference after
# each one shows where. Nothing here is decorative.
#
# HOW TO USE
#   Local dev : cp .env.example .env.local   (.env.local is gitignored)
#   Vercel    : Project Settings > Environment Variables > Import .env,
#               upload your filled-in copy, tick Production + Preview +
#               Development, then redeploy.
#
# Fill in every value marked FILL_ME. Comment lines (#) are ignored on import.
# Never commit a filled-in copy — .gitignore allows only this template through.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — REQUIRED. Without these the contact form and admin portal are dead.
# -----------------------------------------------------------------------------
# Project ref iwjexpultcwtowmtwgns (org "sujiar", region ap-south-1). Verify it
# still matches Dashboard > Project Settings > General > Project ID before use:
# a stale ref is what broke the contact form, and it fails as an unhelpful
# "fetch failed" because a dead ref has no DNS record at all.
# Read by: src/lib/supabase.ts, src/lib/supabaseService.ts,
#          utils/supabase/{client,server,middleware}.ts
NEXT_PUBLIC_SUPABASE_URL="https://iwjexpultcwtowmtwgns.supabase.co"

# Dashboard > Project Settings > API Keys > publishable key (starts sb_publishable_).
# This one is public by design — it ships in the browser bundle for the admin
# portal and questionnaire. Row Level Security is what protects the data.
# Read by: same files as above.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="FILL_ME"


# -----------------------------------------------------------------------------
# SMTP — transactional email delivery.
# -----------------------------------------------------------------------------
# Optional, but if unset every email is silently logged to the email_logs table
# and never actually sent: no customer welcome mail, no admin alert on a new
# inquiry, no meeting invite. Form submission itself still succeeds.
# HOST + USER + PASS are the three that must all be present to enable sending.
#
# Set these in Vercel only. This file is committed, so it carries no real mail
# server, mailbox or password — take the values from your provider's "Secure
# SSL/TLS (recommended)" panel and paste them straight into Vercel's
# Environment Variables, or into a local .env.local that is never committed.
#
# Read by: src/lib/mailer.ts (used by /api/inquiry and /api/send-email)
SMTP_HOST="FILL_ME"
SMTP_USER="FILL_ME"
SMTP_PASS="FILL_ME"

# Use the provider's outgoing/SMTP port. SMTP_SECURE must be the string "true"
# or "false" and has to match the port: "true" for 465 (implicit TLS), "false"
# for 587 (STARTTLS).
SMTP_PORT="465"
SMTP_SECURE="true"

# Envelope sender. Defaults to SMTP_USER if omitted. Keep the address equal to
# SMTP_USER — most providers reject a From: that is not the authenticated
# mailbox. Format: Display Name <mailbox@domain>
SMTP_FROM="FILL_ME"


# -----------------------------------------------------------------------------
# Analytics — Google Analytics 4 and Google Tag Manager.
# -----------------------------------------------------------------------------
# Both are optional and independent. Leave a value empty and that tag is never
# injected at all — which is why local dev and preview deployments stay out of
# production reporting without any extra guard.
#
# Consent Mode v2 is wired up regardless: the tag boots denied-by-default and is
# only granted what the visitor ticks in the cookie banner. A visitor who
# declines is still measured, cookielessly and without identifiers, which is the
# behaviour UU PDP 27/2022 and GDPR expect.
#
# GA4 measurement ID: Admin > Data streams > your web stream ("G-" prefix).
# Read by: src/lib/gtag.ts (via src/components/shared/AnalyticsProvider.tsx)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# GTM container ID ("GTM-" prefix). Set this only if the marketing team needs to
# add pixels (Meta, LinkedIn, TikTok) without a code deploy.
#
# If you set BOTH, do not also put a GA4 Configuration tag inside the container:
# GA4 is already loaded directly by the line above, and a second config tag
# double-counts every session. Use the container for the ad pixels only; they
# fire on the `cg_`-prefixed events this app pushes (cg_page_view,
# cg_generate_lead, cg_contact_click, cg_cta_click, cg_scroll_depth).
NEXT_PUBLIC_GTM_ID=""


# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Origin used for links inside emails (questionnaire link, admin dashboard
# link). On Vercel this is auto-detected from VERCEL_PROJECT_PRODUCTION_URL, so
# set it only to force a specific domain — e.g. to keep emails pointing at the
# www host rather than a preview deployment URL.
# Read by: src/lib/appUrl.ts
NEXT_PUBLIC_APP_URL="https://www.cargogrid.net"

# Server-only overrides, checked before the NEXT_PUBLIC_ pair by the API route.
# Only useful if you ever need the server to talk to a different project than
# the browser does. Leave unset otherwise — two sources of truth for one value
# is how they drift apart.
# Read by: src/lib/supabaseService.ts
# SUPABASE_URL=""
# SUPABASE_PUBLISHABLE_KEY=""


# -----------------------------------------------------------------------------
# Supabase keys you do NOT need — one publishable key is the whole set
# -----------------------------------------------------------------------------
# SECRET KEY (sb_secret_..., formerly service_role) — do not add it.
#   Nothing in this repo reads it, and adding it would be a downgrade in
#   safety, not an upgrade: it bypasses Row Level Security entirely. The API
#   route uses the publishable key on purpose, because create_inquiry and
#   log_email are SECURITY DEFINER functions already granted to `anon` — the
#   server needs no more privilege than the browser had. Keep it out of Vercel
#   too, so a future bug cannot reach for it.
#
# ANON KEY (legacy JWT, superseded by the publishable key) — not needed.
#   Read only as a fallback when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is unset,
#   so it stays dead weight on any current setup. The line below exists only
#   for old deployments still issuing legacy JWT keys; leave it commented out.
#   Read by: src/lib/supabase.ts, src/lib/supabaseService.ts, utils/supabase/*.ts
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
#
# SUPABASE_JWKS_URL — nothing reads it; supabase-js handles auth itself.


# -----------------------------------------------------------------------------
# Injected automatically by Vercel — never set these yourself
# -----------------------------------------------------------------------------
#   VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL
